# APP_ENV=development
# CLIMATE_PROVIDER=era5_land_timeseries
# DATA_DIR=data
# JOB_METADATA_DB_PATH=data/cache/jobs.sqlite3
# API_BASE_URL=http://localhost:8000
# API_TIMEOUT_SECONDS=180

# # Required only when CLIMATE_PROVIDER=era5
# CDS_URL=https://cds.climate.copernicus.eu/api
# CDS_API_KEY=


# # Phase 4 safety limits for direct ERA5 requests
# ERA5_DATASET=reanalysis-era5-single-levels
# ERA5_MAX_DAYS_PER_REQUEST=7
# ERA5_POINT_BUFFER_DEGREES=0.25

# # Phase 8 near-real-time synchronization
# ERA5_SYNC_ENABLED=false
# ERA5_SYNC_INTERVAL_HOURS=6
# ERA5_SYNC_AVAILABILITY_LAG_DAYS=5
# ERA5_SYNC_MAX_DAYS_PER_RUN=7
# ERA5_SYNC_VARIABLE=2m_temperature
# ERA5_SYNC_START_DATE=2025-01-01
# ERA5_SYNC_AREA_NORTH=11.0
# ERA5_SYNC_AREA_WEST=106.0
# ERA5_SYNC_AREA_SOUTH=10.0
# ERA5_SYNC_AREA_EAST=107.0
# ERA5_SYNC_FREQUENCY=hourly
