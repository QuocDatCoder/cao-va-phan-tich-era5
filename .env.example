# Sao chép file này thành .env (cùng thư mục gốc) rồi sửa giá trị. KHÔNG commit file .env.
# Sau khi sửa .env phải khởi động lại backend. Biến đã đặt trong terminal ($env:...) luôn thắng .env.

# ===== Nguồn dữ liệu =====
# mock                 : dữ liệu giả lập, không cần CDS key (dùng để chạy thử/tích hợp)
# era5                 : ERA5 single-levels, tải theo vùng, mỗi request tối đa vài ngày
# era5_land_timeseries : ERA5-Land time-series (dataset trong slide), một điểm, nhiều biến
CLIMATE_PROVIDER=mock
DATA_DIR=data
JOB_METADATA_DB_PATH=data/cache/jobs.sqlite3
# Mặc định: data/cache/climate.sqlite3
# CLIMATE_DATA_DB_PATH=data/cache/climate.sqlite3

# ===== Frontend (Streamlit) =====
# Địa chỉ backend. 127.0.0.1 luôn là máy đang chạy frontend.
# Lưu ý: frontend có thể chỉ đọc biến môi trường, hãy đặt bằng $env:API_BASE_URL nếu .env không có tác dụng.
API_BASE_URL=http://127.0.0.1:8000
# Thời gian chờ backend (giây). Lần tải đầu từ CDS có thể rất lâu nên nên để lớn.
API_TIMEOUT_SECONDS=900

# ===== Tài khoản CDS (chỉ cần khi CLIMATE_PROVIDER là era5 hoặc era5_land_timeseries) =====
# Lấy token ở trang profile CDS và chấp nhận điều khoản của dataset trước khi tải.
CDS_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# ===== Giới hạn truy vấn chung =====
# Số ngày tối đa cho một lần truy vấn qua API.
ERA5_MAX_QUERY_DAYS=366

# ===== Dataset ERA5 single-levels (chỉ dùng khi CLIMATE_PROVIDER=era5) =====
ERA5_DATASET=reanalysis-era5-single-levels
# Số ngày tối đa trong một request CDS (backend tự chia đợt).
ERA5_MAX_DAYS_PER_REQUEST=7
# Khung (độ) lấy quanh điểm khi truy vấn một điểm.
ERA5_POINT_BUFFER_DEGREES=0.25

# ===== Dataset ERA5-Land time-series (chỉ dùng khi CLIMATE_PROVIDER=era5_land_timeseries) =====
ERA5_LAND_DATASET=reanalysis-era5-land-timeseries
# Số ngày tối đa trong một request. Giảm xuống (ví dụ 31) nếu CDS từ chối khoảng dài.
ERA5_LAND_MAX_DAYS_PER_REQUEST=366

# ===== Đồng bộ dữ liệu mới (scheduler của backend) =====
# Mặc định tắt. Chỉ bật khi đã chạy thử thành công với dữ liệu thật.
ERA5_SYNC_ENABLED=false
# Chu kỳ chạy (giờ).
ERA5_SYNC_INTERVAL_HOURS=6
# Độ trễ công bố của ERA5 (ngày): ngày mới nhất tải được = hôm nay trừ số này.
ERA5_SYNC_AVAILABILITY_LAG_DAYS=5
# Số ngày tối đa mỗi lần đồng bộ.
ERA5_SYNC_MAX_DAYS_PER_RUN=7
# Chỉ đồng bộ MỘT biến cho MỘT vùng, không theo lựa chọn trên dashboard.
ERA5_SYNC_VARIABLE=2m_temperature
# Đặt gần ngày hiện tại, nếu quá xa thì phải chạy rất nhiều lượt mới bắt kịp.
ERA5_SYNC_START_DATE=2026-10-25
# Vùng đồng bộ. Với era5_land_timeseries, backend lấy TÂM của vùng làm điểm cần tải,
# nên tâm phải trùng điểm đang xem trên dashboard (mặc định 10.8231, 106.6297).
ERA5_SYNC_AREA_NORTH=11.0731
ERA5_SYNC_AREA_WEST=106.3797
ERA5_SYNC_AREA_SOUTH=10.5731
ERA5_SYNC_AREA_EAST=106.8797
ERA5_SYNC_FREQUENCY=hourly
